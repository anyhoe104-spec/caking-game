# Cloudflare Pages / Netlify cache policy. Ignored by GitHub Pages (harmless).
#
# Vite content-hashes everything under /assets/, so those can be cached forever.
# Everything the browser must re-check on each visit is marked no-cache — above
# all sw.js: a cached service worker is a service worker that never updates, and
# players would stay pinned to an old build.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

# Not content-hashed, so they cannot be immutable. The service worker caches
# them anyway; bumping its CACHE name is what actually forces a refresh.
/sounds/*
  Cache-Control: public, max-age=86400

/images/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400
